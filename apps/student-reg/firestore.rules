rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ Collection: users (การลงทะเบียนนักศึกษา, อนุมัติ Walk-in, เช็คชื่อ, แจกเสื้อ)
    match /users/{userId} {
      allow read, write, create, update, get, list: if true;
      allow delete: if false;
    }

    // ✅ Collection: shirt_inventory (สต็อกเสื้อคลังจริง)
    match /shirt_inventory/{docId} {
      allow read, write, create, update, get, list: if true;
    }

    // ✅ Collection: shirt_checkin_logs (Log การแจกเสื้อ)
    match /shirt_checkin_logs/{logId} {
      allow read, write, create, get, list: if true;
    }

    // ✅ Collection: registration_checkin_logs (Log การเช็คชื่อลงทะเบียน)
    match /registration_checkin_logs/{logId} {
      allow read, write, create, get, list: if true;
    }

    // ✅ Collection: staff_access_logs (Log การเข้าใช้งานสตาฟฟ์)
    match /staff_access_logs/{logId} {
      allow read, write, create, get, list: if true;
    }

    // ✅ Collection: used_short_codes (ระบบจองรหัส Short Code ป้องกันการซ้ำ)
    match /used_short_codes/{code} {
      allow read, write, create, update, get, list: if true;
    }

    // ✅ Collection: staff_applicants (ข้อมูลสตาฟฟ์)
    match /staff_applicants/{userId} {
      allow read, write, create, update, get, list: if true;
    }
  }
}
