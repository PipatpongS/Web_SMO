rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ Collection: users
    match /users/{userId} {
      allow read, write, create, update, get, list: if true;
      allow delete: if false;
    }

    // ✅ Collection: staff_applicants
    match /staff_applicants/{userId} {
      allow read, write, create, update, get, list: if true;
    }
  }
}
